# CRM - environment template (docs/DECISIONS.md D-1, D-5, D-10, D-11, D-13).
# Copy to .env locally. On the server every value is set by hand in .env and never committed.
# Every key read by config/*.php is listed (tests/Feature/System/EnvExampleTest.php keeps it so).
# Each comment gives the purpose, then "Local:" (the value below) and "Production:" (what the server needs).
# "null" means "not set"; drivers the CRM does not use keep the framework default.
# No secret and no real host belongs in this file.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Name shown in the browser title and mail. Local: CRM. Production: the organisation's product name.
APP_NAME=CRM
# Environment. Local: local. Production: production (enables the production checks of app:preflight).
APP_ENV=local
# Encryption key. Local: generated by `php artisan key:generate`. Production: set on the server, never shared.
APP_KEY=
# Comma-separated earlier keys, still accepted for decryption after a key rotation. Local: empty. Production: set on the server when rotating.
APP_PREVIOUS_KEYS=
# Stack traces in the browser. Local: true. Production: false (app:preflight fails otherwise).
APP_DEBUG=true
# Base URL for links, signed URLs and mail. Local: http://crm.test (Herd). Production: the https URL, set on the server.
APP_URL=http://crm.test
# Default locale, Arabic (D-5). Local: ar. Production: ar.
APP_LOCALE=ar
# Fallback locale, must differ from APP_LOCALE so a missing Arabic key resolves to English (D-5). Local: en. Production: en.
APP_FALLBACK_LOCALE=en
# Faker locale for factories in tests. Local: ar_SA. Production: ar_SA (unused).
APP_FAKER_LOCALE=ar_SA
# Timezone the date-times are stored in (D-8). Local: Asia/Riyadh. Production: Asia/Riyadh.
APP_TIMEZONE=Asia/Riyadh
# Where `php artisan down` is recorded. Local: file. Production: file (one server).
APP_MAINTENANCE_DRIVER=file
# Cache store used only when APP_MAINTENANCE_DRIVER=cache. Local: database. Production: database (unused with the file driver).
APP_MAINTENANCE_STORE=database

# Workers of `php artisan serve` (framework, not read under config/). Local: commented. Production: unused.
# PHP_CLI_SERVER_WORKERS=4

# Bcrypt cost (framework hashing default). Local: 12. Production: 12.
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# First super admin (php artisan app:onboard)
# ---------------------------------------------------------------------------

# Name, e-mail and password of the first super admin; leave blank to be prompted. Local: blank. Production: blank (type them at the prompt).
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# Default guard. Local: web. Production: web.
AUTH_GUARD=web
# Password broker for invitations and resets. Local: users. Production: users.
AUTH_PASSWORD_BROKER=users
# User model. Local: App\Models\User. Production: App\Models\User.
AUTH_MODEL='App\Models\User'
# Table of password reset (and invitation) tokens. Local: password_reset_tokens. Production: password_reset_tokens.
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
# Seconds before a password confirmation is asked again. Local: 10800. Production: 10800.
AUTH_PASSWORD_TIMEOUT=10800

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Default log channel. Local: stack. Production: stack.
LOG_CHANNEL=stack
# Channels of the stack. Local: single. Production: daily (rotated by LOG_DAILY_DAYS).
LOG_STACK=single
# Minimum level written. Local: debug. Production: warning.
LOG_LEVEL=debug
# Days of daily log files kept. Local: 14. Production: 14.
LOG_DAILY_DAYS=14
# Channel for PHP and framework deprecations. Local: null (discarded). Production: null.
LOG_DEPRECATIONS_CHANNEL=null
# Stack traces on deprecation entries. Local: false. Production: false.
LOG_DEPRECATIONS_TRACE=false
# Slack, Papertrail, stderr and syslog channels are not used by the CRM. Local and production: the framework defaults below.
LOG_SLACK_WEBHOOK_URL=null
LOG_SLACK_USERNAME="${APP_NAME}"
LOG_SLACK_EMOJI=:boom:
LOG_PAPERTRAIL_HANDLER='Monolog\Handler\SyslogUdpHandler'
PAPERTRAIL_URL=null
PAPERTRAIL_PORT=null
LOG_STDERR_FORMATTER=null
LOG_SYSLOG_FACILITY=user

# ---------------------------------------------------------------------------
# Audit ledger (spatie/laravel-activitylog, A-5)
# ---------------------------------------------------------------------------

# Whether audit rows are written. Local: true. Production: true (never switch off).
ACTIVITY_LOGGER_ENABLED=true
# Audit table. Local: activity_log. Production: activity_log.
ACTIVITY_LOGGER_TABLE_NAME=activity_log
# Connection of the audit table; null = the default connection. Local: null. Production: null.
ACTIVITY_LOGGER_DB_CONNECTION=null

# ---------------------------------------------------------------------------
# Database - MySQL 8 only, never SQLite (A-13); the production engine is confirmed in writing (D-1)
# ---------------------------------------------------------------------------

# Driver. Local: mysql. Production: mysql (or mariadb when the host confirms MariaDB).
DB_CONNECTION=mysql
# Full connection URL instead of the fields below. Local: null. Production: null.
DB_URL=null
# Host. Local: 127.0.0.1. Production: set on the server (the host's database hostname).
DB_HOST=127.0.0.1
# Port. Local: 3306. Production: set on the server.
DB_PORT=3306
# Unix socket instead of host and port. Local: empty. Production: empty unless the host requires one.
DB_SOCKET=
# Database name. Local: crm. Production: set on the server.
DB_DATABASE=crm
# User. Local: crm. Production: set on the server.
DB_USERNAME=crm
# Password. Local: crm. Production: set on the server.
DB_PASSWORD=crm
# Character set, needed for Arabic. Local: utf8mb4. Production: utf8mb4.
DB_CHARSET=utf8mb4
# Collation. Local: utf8mb4_unicode_ci. Production: utf8mb4_unicode_ci.
DB_COLLATION=utf8mb4_unicode_ci
# CA certificate for TLS to MySQL. Local: null. Production: set on the server only if the host requires TLS.
MYSQL_ATTR_SSL_CA=null
# SQLite and PostgreSQL connection options, unused. Local and production: the framework defaults.
DB_FOREIGN_KEYS=true
DB_SSLMODE=prefer

# ---------------------------------------------------------------------------
# Session (D-11)
# ---------------------------------------------------------------------------

# Session storage. Local: file. Production: file (or database).
SESSION_DRIVER=file
# Idle minutes before sign-out (D-11). Local: 120. Production: 120 (app:preflight warns otherwise).
SESSION_LIFETIME=120
# Expire the session when the browser closes. Local: false. Production: false.
SESSION_EXPIRE_ON_CLOSE=false
# Encrypt the stored session payload. Local: false. Production: false.
SESSION_ENCRYPT=false
# Connection and table of the database session driver. Local: null / sessions. Production: null / sessions.
SESSION_CONNECTION=null
SESSION_TABLE=sessions
# Cache store of a cache-backed session driver. Local: null. Production: null.
SESSION_STORE=null
# Session cookie name. Local: crm-session. Production: crm-session.
SESSION_COOKIE=crm-session
# Cookie path. Local: /. Production: /.
SESSION_PATH=/
# Cookie domain; null = the request host. Local: null. Production: null.
SESSION_DOMAIN=null
# HTTPS-only cookie (D-11). Local: false (Herd serves http). Production: true (app:preflight fails otherwise).
SESSION_SECURE_COOKIE=false
# Cookie hidden from JavaScript. Local: true. Production: true.
SESSION_HTTP_ONLY=true
# SameSite policy. Local: lax. Production: lax.
SESSION_SAME_SITE=lax
# Partitioned (CHIPS) cookie. Local: false. Production: false.
SESSION_PARTITIONED_COOKIE=false

# ---------------------------------------------------------------------------
# Cache and queue - no Redis, no persistent worker on shared hosting (D-1)
# ---------------------------------------------------------------------------

# Default cache store. Local: file. Production: file or database (never array: app:preflight fails).
CACHE_STORE=file
# Key prefix. Local: crm-cache-. Production: crm-cache-.
CACHE_PREFIX=crm-cache-
# File store location on the storage disk. Local: null / framework/cache/data. Production: the same.
CACHE_STORAGE_DISK=null
CACHE_STORAGE_PATH=framework/cache/data
# Database cache store: connection, table, lock connection and lock table. Local and production: null / cache / null / null.
DB_CACHE_CONNECTION=null
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=null
DB_CACHE_LOCK_TABLE=null

# Queue connection; the scheduler drains the database queue every minute (D-1). Local: database. Production: database (never sync: app:preflight fails).
QUEUE_CONNECTION=database
# Database queue: connection, table, queue name and seconds before a job is retried. Local and production: null / jobs / default / 90.
DB_QUEUE_CONNECTION=null
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
# Where failed jobs are recorded. Local: database-uuids. Production: database-uuids.
QUEUE_FAILED_DRIVER=database-uuids

# Memcached, Redis, DynamoDB, Beanstalkd and SQS are not used (D-1). Local and production: the framework defaults below.
MEMCACHED_PERSISTENT_ID=null
MEMCACHED_USERNAME=null
MEMCACHED_PASSWORD=null
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
REDIS_CLIENT=phpredis
REDIS_CLUSTER=redis
REDIS_PREFIX=crm-database-
REDIS_PERSISTENT=false
REDIS_URL=null
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
DYNAMODB_CACHE_TABLE=cache
DYNAMODB_ENDPOINT=null
BEANSTALKD_QUEUE_HOST=localhost
BEANSTALKD_QUEUE=default
BEANSTALKD_QUEUE_RETRY_AFTER=90
SQS_PREFIX=null
SQS_QUEUE=default
SQS_SUFFIX=null

# Broadcasting (framework default config, not read under config/). Local: log. Production: log (unused).
BROADCAST_CONNECTION=log

# ---------------------------------------------------------------------------
# Mail (D-10: log mailer until production SMTP is configured)
# ---------------------------------------------------------------------------

# Mailer. Local: log (invitation links appear in storage/logs/laravel.log). Production: smtp once credentials exist (app:preflight warns while log).
MAIL_MAILER=log
# SMTP scheme: null (STARTTLS negotiated), smtp or smtps. Local: null. Production: set on the server.
MAIL_SCHEME=null
# Full SMTP URL instead of the fields below. Local: null. Production: null.
MAIL_URL=null
# SMTP host. Local: 127.0.0.1 (unused with log). Production: set on the server.
MAIL_HOST=127.0.0.1
# SMTP port. Local: 2525. Production: set on the server.
MAIL_PORT=2525
# SMTP user. Local: null. Production: set on the server.
MAIL_USERNAME=null
# SMTP password. Local: null. Production: set on the server.
MAIL_PASSWORD=null
# Domain announced in the SMTP greeting. Local: crm.test. Production: the site's host name.
MAIL_EHLO_DOMAIN=crm.test
# Log channel of the log mailer; null = the default channel. Local: null. Production: null.
MAIL_LOG_CHANNEL=null
# Sendmail binary of the unused sendmail mailer. Local and production: the framework default.
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
# Sender address and name. Local: crm@example.com / CRM. Production: set on the server (an address of the organisation's domain).
MAIL_FROM_ADDRESS="crm@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# API keys of mail services the CRM does not use. Local and production: null.
POSTMARK_API_KEY=null
RESEND_API_KEY=null
# Slack notification credentials, unused. Local and production: null.
SLACK_BOT_USER_OAUTH_TOKEN=null
SLACK_BOT_USER_DEFAULT_CHANNEL=null

# ---------------------------------------------------------------------------
# Files - attachments and exports live on the private local disk (A-6, D-13)
# ---------------------------------------------------------------------------

# Default filesystem disk. Local: local. Production: local.
FILESYSTEM_DISK=local
# S3 credentials, unused (and shared by the unused SQS and DynamoDB drivers). Local and production: null / us-east-1 / false.
AWS_ACCESS_KEY_ID=null
AWS_SECRET_ACCESS_KEY=null
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=null
AWS_URL=null
AWS_ENDPOINT=null
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# CRM (config/crm.php)
# ---------------------------------------------------------------------------

# Currency seeded into General Settings on first install (D-8). Local: SAR. Production: SAR.
CRM_CURRENCY=SAR
# Organisation timezone seeded into General Settings on first install (D-8). Local: Asia/Riyadh. Production: Asia/Riyadh.
CRM_TIMEZONE=Asia/Riyadh
# Days without activity before an open lead is reported stale to its owner. Local: 14. Production: 14.
CRM_LEAD_STALE_DAYS=14
# Days audit rows are kept before the weekly prune (D-13). Local: 730. Production: 730.
CRM_AUDIT_RETENTION_DAYS=730
# Largest attachment in kilobytes. Local: 10240. Production: 10240 (and within the host's upload_max_filesize).
CRM_ATTACHMENT_MAX_KB=10240
# Reverse proxies whose X-Forwarded-* headers are trusted (App\Http\Middleware\TrustProxies): null = nobody,
# * = any peer (lets any client spoof its IP when PHP is reachable directly), or a comma-separated list of IPs/CIDRs.
# Local: null (no proxy). Production: set on the server - the proxy addresses the host publishes, * only when PHP
# is reachable solely through the host's proxy (app:preflight warns while unset).
CRM_TRUSTED_PROXIES=null

# ---------------------------------------------------------------------------
# Front-end build
# ---------------------------------------------------------------------------

# App name exposed to Vite at build time (assets are built in CI, D-1). Local: ${APP_NAME}. Production: ${APP_NAME}.
VITE_APP_NAME="${APP_NAME}"
