includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Level 5 is the inherited baseline (Stockflow). Raise it deliberately, one level at a
    # time, fixing what each new level surfaces - never by adding ignoreErrors entries.
    level: 5

    # Production runs PHP 8.3 (D-1); local Herd is 8.4. Analyse at the floor so 8.4-only
    # syntax cannot slip in.
    phpVersion: 80300

    paths:
        - app
        - config
        - database
        - routes
        - tests

    # Larastan resolves model properties, relations and container bindings by booting the
    # application. Without this every Eloquent magic property is reported as undefined.
    bootstrapFiles:
        - vendor/autoload.php

    # Model attributes are checked against the database schema. Enum/date/decimal casts are
    # invisible to the schema, so every cast needs a @property docblock on the model.
    checkModelProperties: true

    # Corrects a vendor PHPDoc that is narrower than the vendor's own runtime:
    # Widget::$columnSpan documents its array values as `int | null`, while
    # ComponentAttributeBag::gridColumn() (support/src/View, lines 160-163) accepts and
    # renders 'full' per breakpoint. A stub is PHPStan's own mechanism for fixing
    # third-party types - it corrects the type, it suppresses nothing, and it is not an
    # ignoreErrors entry. Delete stub and this block when the upstream PHPDoc catches up.
    stubFiles:
        - phpstan-stubs/FilamentWidget.stub

    # No baseline and no inline ignores. A genuine false positive is documented with the vendor
    # line that proves it in docs/Static_Analysis_Known_False_Positives.md.
